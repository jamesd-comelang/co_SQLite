module differential_test
import std
import string
import tokenizer

// GENERATED by tools/corpus.py from the corpus in
// tools/corpus.py and the expected streams produced by
// SQLite's own sqlite3GetToken (tools/difftest.c).
// Regenerate with tools/run_diff.sh -- do not edit.

int failures = 0

int cur_idx = 0

void open_case(tokenizer tz, int idx, string sql) {
    cur_idx = idx
    tz.open(sql)
}

void tok(tokenizer tz, string spec) {
    if (!tz.next()) {
        std.out.printf("FAIL case %d: missing token, want %s\n", cur_idx, spec)
        failures = failures + 1
        return
    }
    string f[] = spec.split(":")
    if (tz.typ() != int(f[0].tol()) || tz.start() != int(f[1].tol()) || tz.len() != int(f[2].tol())) {
        std.out.printf("FAIL case %d: got %s(%d) @%d +%d, want %s\n", cur_idx, tokenizer.token_name(tz.typ()), tz.typ(), tz.start(), tz.len(), spec)
        failures = failures + 1
    }
}

void end_case(tokenizer tz) {
    if (tz.next()) {
        std.out.printf("FAIL case %d: extra token %s @%d +%d\n", cur_idx, tokenizer.token_name(tz.typ()), tz.start(), tz.len())
        failures = failures + 1
    }
}

