module tokenizer

import string

// chars.co -- character classification for module tokenizer:
// the aiClass[] table and sqlite3CtypeMap predicates from
// SQLite's tokenize.c, over BYTES -- since COIL-141 fixed
// string.byte_array(), the scanner works on the input's bytes
// exactly like the C code does. The CC_* class constants and
// CP_SQUOTE are declared once in tokenizer.co and shared by
// every file of this module (COIL-148).

// Byte at offset i of b as an unsigned value 0..255 (Come's
// byte is signed), or 0 past the end -- the same role the
// terminating NUL plays in the C code.
int tk_byte(byte[] b, int i) {
    if (i < 0 || i >= b.length()) { return 0 }
    int v = int(b[i])
    if (v < 0) { v = v + 256 }
    return v
}

// sqlite3Isspace: {tab, LF, VT, FF, CR, space} per sqlite3CtypeMap.
bool tk_is_space(int c) {
    return c == 32 || (c >= 9 && c <= 13)
}

bool tk_is_digit(int c) {
    return c >= '0' && c <= '9'
}

bool tk_is_xdigit(int c) {
    if (tk_is_digit(c)) { return true }
    if (c >= 'a' && c <= 'f') { return true }
    return c >= 'A' && c <= 'F'
}

// IdChar() from tokenize.c: (sqlite3CtypeMap[c] & 0x46) != 0, i.e.
// letters, digits, '_' and '$', plus every byte >= 0x80.
bool tk_is_idchar(int c) {
    if (c >= 0x80) { return true }
    if (tk_is_digit(c)) { return true }
    if (c >= 'A' && c <= 'Z') { return true }
    if (c >= 'a' && c <= 'z') { return true }
    return c == '_' || c == '$'
}

// aiClass[] (SQLITE_ASCII build), per byte: 0xEF is CC_BOM (the
// get_token BOM case then checks the full EF BB BF sequence);
// every other byte >= 0x80 is CC_ID.
int tk_class(int c) {
    if (c == 0) { return CC_NUL }
    if (c == 0xEF) { return CC_BOM }
    if (c >= 0x80) { return CC_ID }
    if (c == 'x' || c == 'X') { return CC_X }
    if ((c >= 'A' && c <= 'W') || (c >= 'a' && c <= 'w')) { return CC_KYWD0 }
    if ((c >= 'Y' && c <= 'Z') || (c >= 'y' && c <= 'z') || c == '_') { return CC_KYWD }
    if (tk_is_digit(c)) { return CC_DIGIT }
    if (c == '$') { return CC_DOLLAR }
    if (c == '@' || c == '#' || c == ':') { return CC_VARALPHA }
    if (c == '?') { return CC_VARNUM }
    if (tk_is_space(c)) {
        // Quirk of the C table: VT (0x0B) is CC_ILLEGAL as the FIRST
        // byte of a token, even though it is whitespace inside a run.
        if (c == 11) { return CC_ILLEGAL }
        return CC_SPACE
    }
    if (c == '"' || c == CP_SQUOTE || c == '`') { return CC_QUOTE }
    if (c == '[') { return CC_QUOTE2 }
    if (c == '|') { return CC_PIPE }
    if (c == '-') { return CC_MINUS }
    if (c == '<') { return CC_LT }
    if (c == '>') { return CC_GT }
    if (c == '=') { return CC_EQ }
    if (c == '!') { return CC_BANG }
    if (c == '/') { return CC_SLASH }
    if (c == '(') { return CC_LP }
    if (c == ')') { return CC_RP }
    if (c == ';') { return CC_SEMI }
    if (c == '+') { return CC_PLUS }
    if (c == '*') { return CC_STAR }
    if (c == '%') { return CC_PERCENT }
    if (c == ',') { return CC_COMMA }
    if (c == '&') { return CC_AND }
    if (c == '~') { return CC_TILDA }
    if (c == '.') { return CC_DOT }
    return CC_ILLEGAL
}

// Char index of byte offset byte_pos in b: the count of bytes
// before it that are not UTF-8 continuation bytes. Used only to
// cut a (pure-ASCII) keyword candidate out of the source string.
int tk_char_index(byte[] b, int byte_pos) {
    int n = 0
    for (int k = 0; k < byte_pos; k++) {
        int c = tk_byte(b, k)
        if (c < 0x80 || c >= 0xC0) { n = n + 1 }
    }
    return n
}

// ----------------------------------------------------------------
// UTF-8 helpers, kept for token_text(), which extracts a token's
// text from the source string by byte extent.

int tk_utf8_len(int cp) {
    if (cp < 0x80) { return 1 }
    if (cp < 0x800) { return 2 }
    if (cp < 0x10000) { return 3 }
    return 4
}

// Codepoint at character index i, or 0 when out of range.
int tk_cp(string sql, int i) {
    if (i < 0 || i >= sql.length()) { return 0 }
    return int(sql[i])
}
