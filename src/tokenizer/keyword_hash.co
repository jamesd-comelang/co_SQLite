// kw_hash_code(b, pos, len, t, x): the TK_* code for the
// byte range b[pos..pos+len), or TK_ID. t/x come from
// build_kw_tables()/build_kw_text() (cursor: built once in create();
// stateless callers: built per call).
int kw_hash_code(byte[] b, int pos, int len, int[] t, byte[] x) {
    if (len < 2 || len > 17) {
        return TK_ID
    }
    int c0 = int(b[pos])
    if (c0 < 0) { c0 = c0 + 256 }
    int c1 = int(b[pos + len - 1])
    if (c1 < 0) { c1 = c1 + 256 }
    int h = (((c0 | 32) * 4) ^ ((c1 | 32) * 3) ^ len) % 127
    int i = t[h]
    while (i >= 0) {
        if (t[274 + i] == len) {
            int off = t[421 + i]
            int f1 = int(b[pos + 1])
            if (f1 < 0) { f1 = f1 + 256 }
            bool ok = true
            if ((c0 & 223) != int(x[off]) || (f1 & 223) != int(x[off + 1])) {
                ok = false
            } else {
                int j = 2
                while (j < len && ok) {
                    int fj = int(b[pos + j])
                    if (fj < 0) { fj = fj + 256 }
                    if ((fj & 223) != int(x[off + j])) {
                        ok = false
                    } else {
                        j = j + 1
                    }
                }
            }
            if (ok) {
                return t[568 + i]
            }
        }
        i = t[127 + i]
    }
    return TK_ID
}
