module keywords_test
import std
import string
import tokenizer

// GENERATED (perf2) -- keyword hash vs the verified map:
// every SQLite keyword (147) in lower, UPPER and alternating
// case via get_token (per-call hash tables), plus cursor
// passes (next/fast_next, instance hash tables) over all
// keywords, plus miss cases. The map (keywords.co) is
// already verified against C sqlite3GetToken, so hash==map
// here transitively verifies hash against C.

int failures = 0
int cases = 0

void check(string word, int code) {
    cases = cases + 1
    (t, n) = tokenizer.get_token(word, 0)
    if (t != code || n != word.length()) {
        std.out.printf("MISMATCH: [%s] got (%d,%d) want (%d,%d)\n", word, t, n, code, word.length())
        failures = failures + 1
    }
}

