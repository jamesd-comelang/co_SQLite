int failures = 0

int cur_idx = 0

void open_case(tokenizer tz, int idx, string sql) {
    cur_idx = idx
    tz.open(sql)
}

void tok(tokenizer tz, string spec) {
    if (!tz.next()) {
        std.out.printf("FAIL fuzz %d: missing token, want %s\n", cur_idx, spec)
        failures = failures + 1
        return
    }
    string f[] = spec.split(":")
    if (tz.typ() != int(f[0].tol()) || tz.start() != int(f[1].tol()) || tz.len() != int(f[2].tol())) {
        std.out.printf("FAIL fuzz %d: got %s(%d) @%d +%d, want %s\n", cur_idx, tokenizer.token_name(tz.typ()), tz.typ(), tz.start(), tz.len(), spec)
        failures = failures + 1
    }
}

void end_case(tokenizer tz) {
    if (tz.next()) {
        std.out.printf("FAIL fuzz %d: extra token %s @%d +%d\n", cur_idx, tokenizer.token_name(tz.typ()), tz.start(), tz.len())
        failures = failures + 1
    }
}

