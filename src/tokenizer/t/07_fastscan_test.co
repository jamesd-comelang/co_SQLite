module fastscan_test
import std
import string
import tokenizer

// GENERATED (perf-experiments branch only) -- fast_scan vs
// get_token differential: every input from the 04 differential
// and 06 fuzz suites, plus edge cases. The slow scanner is
// already verified against C sqlite3GetToken, so fast==slow
// here transitively verifies fast against C too.

int failures = 0
int cases = 0

void check(string sql) {
    var a = tokenizer.create()
    var b = tokenizer.create()
    a.open(sql)
    b.open(sql)
    cases = cases + 1
    while (a.next()) {
        if (!b.fast_next()) {
            std.out.printf("MISMATCH: fast stopped early in [%s]\n", sql)
            failures = failures + 1
            break
        }
        if (a.typ() != b.typ() || a.len() != b.len()) {
            std.out.printf("MISMATCH: slow=(%d,%d) fast=(%d,%d) in [%s]\n", a.typ(), a.len(), b.typ(), b.len(), sql)
            failures = failures + 1
            break
        }
    }
    if (b.fast_next()) {
        std.out.printf("MISMATCH: fast continued past slow end in [%s]\n", sql)
        failures = failures + 1
    }
    a.destroy()
    b.destroy()
}

