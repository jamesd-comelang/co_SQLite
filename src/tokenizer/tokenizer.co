// The single-quote byte. (Written as a named constant for
// readability; the ''' literal itself lexes since COIL-143.)
const CP_SQUOTE = 39

// Character classes, mirroring aiClass[] in tokenize.c. The numeric
// values are SQLite's own (the ordering matters: get_token's keyword
// path compares class <= CC_KYWD). Declared here once; chars.co
// and keywords.co use them directly (module constants, COIL-148).
const (
    CC_X = 0,
    CC_KYWD0 = 1,
    CC_KYWD = 2,
    CC_DIGIT = 3,
    CC_DOLLAR = 4,
    CC_VARALPHA = 5,
    CC_VARNUM = 6,
    CC_SPACE = 7,
    CC_QUOTE = 8,
    CC_QUOTE2 = 9,
    CC_PIPE = 10,
    CC_MINUS = 11,
    CC_LT = 12,
    CC_GT = 13,
    CC_EQ = 14,
    CC_BANG = 15,
    CC_SLASH = 16,
    CC_LP = 17,
    CC_RP = 18,
    CC_SEMI = 19,
    CC_PLUS = 20,
    CC_STAR = 21,
    CC_PERCENT = 22,
    CC_COMMA = 23,
    CC_AND = 24,
    CC_TILDA = 25,
    CC_DOT = 26,
    CC_ID = 27,
    CC_ILLEGAL = 28,
    CC_NUL = 29,
    CC_BOM = 30,
)

// ----------------------------------------------------------------
// The scanner core: sqlite3GetToken() over bytes.
//
// tk_scan(b, pos, sql) returns (token_type, byte_length) for
// the token starting at byte offset pos of b (sql is the string
// b came from, used only to cut out keyword candidates).
// Past-the-end bytes read as 0, like C's NUL.

(int, int) tk_scan(byte[] b, int pos, string sql) {
    int c0 = tk_byte(b, pos)
    int cls = tk_class(c0)

    if (cls == CC_SPACE) {
        int j = pos + 1
        while (tk_is_space(tk_byte(b, j))) { j = j + 1 }
        return TK_SPACE, j - pos
    }
    if (cls == CC_BOM) {
        if (tk_byte(b, pos + 1) == 0xBB && tk_byte(b, pos + 2) == 0xBF) {
            return TK_SPACE, 3
        }
        return TK_ID, tk_id_len(b, pos)
    }
    if (cls == CC_NUL) {
        return TK_ILLEGAL, 0
    }
    if (cls == CC_MINUS) {
        if (tk_byte(b, pos + 1) == '-') {
            int j = pos + 2
            while (tk_byte(b, j) != '\n' && tk_byte(b, j) != 0) { j = j + 1 }
            return TK_COMMENT, j - pos
        }
        if (tk_byte(b, pos + 1) == '>') {
            int n = 2
            if (tk_byte(b, pos + 2) == '>') { n = 3 }
            return TK_PTR, n
        }
        return TK_MINUS, 1
    }
    if (cls == CC_LP) { return TK_LP, 1 }
    if (cls == CC_RP) { return TK_RP, 1 }
    if (cls == CC_SEMI) { return TK_SEMI, 1 }
    if (cls == CC_PLUS) { return TK_PLUS, 1 }
    if (cls == CC_STAR) { return TK_STAR, 1 }
    if (cls == CC_PERCENT) { return TK_REM, 1 }
    if (cls == CC_COMMA) { return TK_COMMA, 1 }
    if (cls == CC_AND) { return TK_BITAND, 1 }
    if (cls == CC_TILDA) { return TK_BITNOT, 1 }
    if (cls == CC_SLASH) {
        if (tk_byte(b, pos + 1) != '*' || tk_byte(b, pos + 2) == 0) {
            return TK_SLASH, 1
        }
        int j = pos + 2
        while (tk_byte(b, j) != 0) {
            if (tk_byte(b, j) == '*' && tk_byte(b, j + 1) == '/') {
                return TK_COMMENT, j + 2 - pos
            }
            j = j + 1
        }
        return TK_COMMENT, j - pos
    }
    if (cls == CC_EQ) {
        if (tk_byte(b, pos + 1) == '=') { return TK_EQ, 2 }
        return TK_EQ, 1
    }
    if (cls == CC_LT) {
        int c1 = tk_byte(b, pos + 1)
        if (c1 == '=') { return TK_LE, 2 }
        if (c1 == '>') { return TK_NE, 2 }
        if (c1 == '<') { return TK_LSHIFT, 2 }
        return TK_LT, 1
    }
    if (cls == CC_GT) {
        int c1 = tk_byte(b, pos + 1)
        if (c1 == '=') { return TK_GE, 2 }
        if (c1 == '>') { return TK_RSHIFT, 2 }
        return TK_GT, 1
    }
    if (cls == CC_BANG) {
        if (tk_byte(b, pos + 1) != '=') { return TK_ILLEGAL, 1 }
        return TK_NE, 2
    }
    if (cls == CC_PIPE) {
        if (tk_byte(b, pos + 1) != '|') { return TK_BITOR, 1 }
        return TK_CONCAT, 2
    }
    if (cls == CC_QUOTE) {
        int delim = c0
        int j = pos + 1
        bool closed = false
        while (tk_byte(b, j) != 0) {
            if (tk_byte(b, j) == delim) {
                if (tk_byte(b, j + 1) == delim) {
                    j = j + 2
                } else {
                    closed = true
                    break
                }
            } else {
                j = j + 1
            }
        }
        if (closed) {
            if (delim == CP_SQUOTE) { return TK_STRING, j + 1 - pos }
            return TK_ID, j + 1 - pos
        }
        return TK_ILLEGAL, j - pos
    }
    if (cls == CC_QUOTE2) {
        int j = pos + 1
        while (tk_byte(b, j) != 0 && tk_byte(b, j) != ']') { j = j + 1 }
        if (tk_byte(b, j) == ']') { return TK_ID, j + 1 - pos }
        return TK_ILLEGAL, j - pos
    }
    if (cls == CC_DOT) {
        if (!tk_is_digit(tk_byte(b, pos + 1))) { return TK_DOT, 1 }
        return tk_number(b, pos)
    }
    if (cls == CC_DIGIT) {
        return tk_number(b, pos)
    }
    if (cls == CC_VARNUM) {
        int j = pos + 1
        while (tk_is_digit(tk_byte(b, j))) { j = j + 1 }
        return TK_VARIABLE, j - pos
    }
    if (cls == CC_DOLLAR || cls == CC_VARALPHA) {
        return tk_variable(b, pos)
    }
    if (cls == CC_KYWD0) {
        if (tk_class(tk_byte(b, pos + 1)) > CC_KYWD) {
            // A lone keyword-start letter: an identifier.
            return TK_ID, tk_id_len(b, pos)
        }
        int j = pos + 2
        while (tk_class(tk_byte(b, j)) <= CC_KYWD && tk_byte(b, j) != 0) { j = j + 1 }
        if (tk_is_idchar(tk_byte(b, j))) {
            // Keyword-shaped, but continues with a digit, '$' or a
            // byte >= 0x80: an identifier.
            return TK_ID, tk_id_len(b, pos)
        }
        // The run is pure ASCII, so char length == byte length.
        int ci = tk_char_index(b, pos)
        string word = sql.substr(ci, ci + (j - pos))
        return keyword_code(word), j - pos
    }
    if (cls == CC_X) {
        if (tk_byte(b, pos + 1) == CP_SQUOTE) {
            // BLOB literal: x'...', hex digits only, even in count.
            int j = pos + 2
            while (tk_is_xdigit(tk_byte(b, j))) { j = j + 1 }
            bool bad = false
            if (tk_byte(b, j) != CP_SQUOTE || (j - pos) % 2 == 1) {
                bad = true
            }
            if (bad) {
                while (tk_byte(b, j) != 0 && tk_byte(b, j) != CP_SQUOTE) { j = j + 1 }
            }
            if (tk_byte(b, j) != 0) { j = j + 1 }
            if (bad) { return TK_ILLEGAL, j - pos }
            return TK_BLOB, j - pos
        }
        return TK_ID, tk_id_len(b, pos)
    }
    if (cls == CC_KYWD || cls == CC_ID) {
        return TK_ID, tk_id_len(b, pos)
    }
    // CC_ILLEGAL and anything unhandled: one byte, TK_ILLEGAL.
    return TK_ILLEGAL, 1
}

// Byte length of the identifier starting at pos: the first byte
// plus the IdChar run after it (the C code's fall-through tail).
int tk_id_len(byte[] b, int pos) {
    int j = pos + 1
    while (tk_is_idchar(tk_byte(b, j))) { j = j + 1 }
    return j - pos
}

// Digit run with '_' separators (SQLITE_DIGIT_SEPARATOR), shared
// by tk_number: returns (new_pos, new_type) -- '_' in the run
// makes the token a TK_QNUMBER.
(int, int) tk_scan_digits(byte[] b, int j, int t) {
    while (true) {
        int c = tk_byte(b, j)
        if (tk_is_digit(c)) {
            j = j + 1
        } else if (c == '_') {
            t = TK_QNUMBER
            j = j + 1
        } else {
            break
        }
    }
    return j, t
}

// Number scanning (CC_DIGIT, and CC_DOT when a digit follows),
// exactly the C control flow.
(int, int) tk_number(byte[] b, int pos) {
    int t = TK_INTEGER
    int j = pos
    if (tk_byte(b, pos) == '0' && (tk_byte(b, pos + 1) == 'x' || tk_byte(b, pos + 1) == 'X') && tk_is_xdigit(tk_byte(b, pos + 2))) {
        // Hexadecimal integer, 0x...
        j = pos + 3
        while (true) {
            int c = tk_byte(b, j)
            if (tk_is_xdigit(c)) {
                j = j + 1
            } else if (c == '_') {
                t = TK_QNUMBER
                j = j + 1
            } else {
                break
            }
        }
    } else {
        (j, t) = tk_scan_digits(b, j, t)
        if (tk_byte(b, j) == '.') {
            if (t == TK_INTEGER) { t = TK_FLOAT }
            j = j + 1
            (j, t) = tk_scan_digits(b, j, t)
        }
        int e = tk_byte(b, j)
        if ((e == 'e' || e == 'E') && (tk_is_digit(tk_byte(b, j + 1)) || ((tk_byte(b, j + 1) == '+' || tk_byte(b, j + 1) == '-') && tk_is_digit(tk_byte(b, j + 2))))) {
            if (t == TK_INTEGER) { t = TK_FLOAT }
            j = j + 2
            (j, t) = tk_scan_digits(b, j, t)
        }
    }
    // A number directly followed by identifier characters is one
    // illegal token in SQLite ("1e", "0xG", "123abc").
    while (tk_is_idchar(tk_byte(b, j))) {
        t = TK_ILLEGAL
        j = j + 1
    }
    return t, j - pos
}

// Variable scanning (CC_DOLLAR and CC_VARALPHA): $, @, :, # names,
// including the Tcl-style $name(...) form (SQLITE_OMIT_TCL_VARIABLE
// is not defined in a default build).
(int, int) tk_variable(byte[] b, int pos) {
    int t = TK_VARIABLE
    int cnt = 0
    int j = pos + 1
    bool done = false
    while (!done) {
        int c = tk_byte(b, j)
        if (c == 0) {
            done = true
        } else if (tk_is_idchar(c)) {
            cnt = cnt + 1
            j = j + 1
        } else if (c == '(' && cnt > 0) {
            j = j + 1
            while (true) {
                int d = tk_byte(b, j)
                if (d == 0 || tk_is_space(d) || d == ')') { break }
                j = j + 1
            }
            if (tk_byte(b, j) == ')') {
                j = j + 1
            } else {
                t = TK_ILLEGAL
            }
            done = true
        } else if (c == ':' && tk_byte(b, j + 1) == ':') {
            j = j + 2
        } else {
            done = true
        }
    }
    if (cnt == 0) { t = TK_ILLEGAL }
    return t, j - pos
}

// ----------------------------------------------------------------
// Public API

// get_token -- sqlite3GetToken(): (token_type, byte_length) for
// the token that begins at byte offset byte_pos of sql. At end of
// input returns (TK_ILLEGAL, 0), exactly like the C code reading
// the terminating NUL.
(int, int) get_token(string sql, int byte_pos) {
    if (byte_pos < 0) { return TK_ILLEGAL, 0 }
    byte[] b = sql.byte_array()
    if (byte_pos >= b.length()) { return TK_ILLEGAL, 0 }
    return tk_scan(b, byte_pos, sql)
}

// token_type_at: the type of the token starting at byte_pos.
int token_type_at(string sql, int byte_pos) {
    (t, _) = get_token(sql, byte_pos)
    return t
}

// token_len_at: the byte length of the token starting at byte_pos.
int token_len_at(string sql, int byte_pos) {
    (_, n) = get_token(sql, byte_pos)
    return n
}

// The text of the token at (byte_start, byte_len) in sql.
string token_text(string sql, int byte_start, int byte_len) {
    int ci = 0
    int b = 0
    while (b < byte_start) {
        b = b + tk_utf8_len(tk_cp(sql, ci))
        ci = ci + 1
    }
    int cj = ci
    int e = byte_start
    while (e < byte_start + byte_len) {
        e = e + tk_utf8_len(tk_cp(sql, cj))
        cj = cj + 1
    }
    return sql.substr(ci, cj)
}

// ----------------------------------------------------------------
// Cursor API (stateful: use through an instance).
//
//   var tz = tokenizer.create()
//   tz.open(sql)
//   while (tz.next()) {
//       ... tz.typ(), tz.start(), tz.len(), tz.text() ...
//   }
//
// next() returns false at end of input, with typ() == TK_ILLEGAL
// and len() == 0 -- the same signal sqlite3GetToken gives on the
// terminating NUL. The cursor converts the input to bytes once
// (open) and builds the keyword table once (the kw_table
// initializer below), where the one-shot get_token pays both
// costs per call.

string tz_sql = ""
byte[] tz_bytes
int tz_pos = 0
int tz_start = 0
int tz_typ = 0
int tz_len = 0

void open(string sql) {
    tz_sql = sql
    tz_bytes = sql.byte_array()
    tz_pos = 0
    tz_start = 0
    tz_typ = 0
    tz_len = 0
}

bool next() {
    if (tz_pos >= tz_bytes.length()) {
        tz_start = tz_pos
        tz_typ = TK_ILLEGAL
        tz_len = 0
        return false
    }
    (t, n) = tk_scan(tz_bytes, tz_pos, tz_sql)
    tz_start = tz_pos
    tz_typ = t
    tz_len = n
    if (n == 0) {
        return false
    }
    tz_pos = tz_pos + n
    return true
}

int typ() {
    return tz_typ
}

int start() {
    return tz_start
}

int len() {
    return tz_len
}

string text() {
    return token_text(tz_sql, tz_start, tz_len)
}
