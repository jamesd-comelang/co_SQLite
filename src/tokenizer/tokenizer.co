// The single-quote codepoint. Written as a number because Come's
// lexer cannot tokenize a single-quote character literal at all
// (neither '\'' nor ''' parses) -- docs/COME_GAPS.md #5.

// NOTE: the CC_* constants are declared again here (same
// values as chars.co) because Come resolves constants per
// file, not per module -- docs/COME_GAPS.md #6.
const CP_SQUOTE = 39

// Character classes, mirroring aiClass[] in tokenize.c. The numeric
// values are SQLite's own (the ordering matters: get_token's keyword
// path compares class <= CC_KYWD).
const (
    CC_X = 0,
    CC_KYWD0 = 1,
    CC_KYWD = 2,
    CC_DIGIT = 3,
    CC_DOLLAR = 4,
    CC_VARALPHA = 5,
    CC_VARNUM = 6,
    CC_SPACE = 7,
    CC_QUOTE = 8,
    CC_QUOTE2 = 9,
    CC_PIPE = 10,
    CC_MINUS = 11,
    CC_LT = 12,
    CC_GT = 13,
    CC_EQ = 14,
    CC_BANG = 15,
    CC_SLASH = 16,
    CC_LP = 17,
    CC_RP = 18,
    CC_SEMI = 19,
    CC_PLUS = 20,
    CC_STAR = 21,
    CC_PERCENT = 22,
    CC_COMMA = 23,
    CC_AND = 24,
    CC_TILDA = 25,
    CC_DOT = 26,
    CC_ID = 27,
    CC_ILLEGAL = 28,
    CC_NUL = 29,
    CC_BOM = 30,
)


// ----------------------------------------------------------------
// get_token -- sqlite3GetToken().
//
// Returns (token_type, byte_length) for the token that begins at
// byte offset byte_pos of sql. At end of input (or on an embedded
// NUL codepoint) returns (TK_ILLEGAL, 0), exactly like the C code
// reading the terminating NUL. A byte_pos that lands in the middle
// of a multi-byte codepoint cannot be addressed in Come's
// character-first strings; it returns (TK_ILLEGAL, 1) -- see
// docs/BEHAVIOR.md.

void tk_get_token(string sql, int byte_pos) {
    int n = sql.length()
    var total_bytes = sql.bytesize()
    if (byte_pos < 0 || byte_pos >= total_bytes) {
        tk_rt = TK_ILLEGAL; tk_rn = 0; return
    }
    // Convert the byte offset to a character index.
    int ci = 0
    int b = 0
    while (b < byte_pos) {
        b = b + tk_utf8_len(tk_cp(sql, ci))
        ci = ci + 1
    }
    if (b != byte_pos) {
        tk_rt = TK_ILLEGAL; tk_rn = 1; return
    }

    int c0 = tk_cp(sql, ci)
    int cls = tk_class(c0)

    if (cls == CC_SPACE) {
        int j = ci + 1
        while (j < n && tk_is_space(tk_cp(sql, j))) {
            j = j + 1
        }
        tk_rt = TK_SPACE; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_BOM) {
        // U+FEFF in a Come string is exactly the 3 bytes EF BB BF.
        tk_rt = TK_SPACE; tk_rn = tk_byte_len(sql, ci, ci + 1); return
    }
    if (cls == CC_NUL) {
        tk_rt = TK_ILLEGAL; tk_rn = 0; return
    }
    if (cls == CC_MINUS) {
        if (tk_cp(sql, ci + 1) == '-') {
            int j = ci + 2
            while (j < n && tk_cp(sql, j) != '\n') {
                j = j + 1
            }
            tk_rt = TK_COMMENT; tk_rn = tk_byte_len(sql, ci, j); return
        }
        if (tk_cp(sql, ci + 1) == '>') {
            int j = ci + 2
            if (tk_cp(sql, ci + 2) == '>') {
                j = j + 1
            }
            tk_rt = TK_PTR; tk_rn = tk_byte_len(sql, ci, j); return
        }
        tk_rt = TK_MINUS; tk_rn = tk_byte_len(sql, ci, ci + 1); return
    }
    if (cls == CC_LP) { tk_rt = TK_LP; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_RP) { tk_rt = TK_RP; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_SEMI) { tk_rt = TK_SEMI; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_PLUS) { tk_rt = TK_PLUS; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_STAR) { tk_rt = TK_STAR; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_PERCENT) { tk_rt = TK_REM; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_COMMA) { tk_rt = TK_COMMA; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_AND) { tk_rt = TK_BITAND; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_TILDA) { tk_rt = TK_BITNOT; tk_rn = tk_byte_len(sql, ci, ci + 1); return }
    if (cls == CC_SLASH) {
        if (tk_cp(sql, ci + 1) != '*' || tk_cp(sql, ci + 2) == 0) {
            tk_rt = TK_SLASH; tk_rn = tk_byte_len(sql, ci, ci + 1); return
        }
        int j = ci + 2
        while (j < n) {
            if (tk_cp(sql, j) == '*' && tk_cp(sql, j + 1) == '/') {
                tk_rt = TK_COMMENT; tk_rn = tk_byte_len(sql, ci, j + 2); return
            }
            j = j + 1
        }
        tk_rt = TK_COMMENT; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_EQ) {
        int j = ci + 1
        if (tk_cp(sql, ci + 1) == '=') {
            j = j + 1
        }
        tk_rt = TK_EQ; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_LT) {
        int c1 = tk_cp(sql, ci + 1)
        if (c1 == '=') { tk_rt = TK_LE; tk_rn = tk_byte_len(sql, ci, ci + 2); return }
        if (c1 == '>') { tk_rt = TK_NE; tk_rn = tk_byte_len(sql, ci, ci + 2); return }
        if (c1 == '<') { tk_rt = TK_LSHIFT; tk_rn = tk_byte_len(sql, ci, ci + 2); return }
        tk_rt = TK_LT; tk_rn = tk_byte_len(sql, ci, ci + 1); return
    }
    if (cls == CC_GT) {
        int c1 = tk_cp(sql, ci + 1)
        if (c1 == '=') { tk_rt = TK_GE; tk_rn = tk_byte_len(sql, ci, ci + 2); return }
        if (c1 == '>') { tk_rt = TK_RSHIFT; tk_rn = tk_byte_len(sql, ci, ci + 2); return }
        tk_rt = TK_GT; tk_rn = tk_byte_len(sql, ci, ci + 1); return
    }
    if (cls == CC_BANG) {
        if (tk_cp(sql, ci + 1) != '=') {
            tk_rt = TK_ILLEGAL; tk_rn = tk_byte_len(sql, ci, ci + 1); return
        }
        tk_rt = TK_NE; tk_rn = tk_byte_len(sql, ci, ci + 2); return
    }
    if (cls == CC_PIPE) {
        if (tk_cp(sql, ci + 1) != '|') {
            tk_rt = TK_BITOR; tk_rn = tk_byte_len(sql, ci, ci + 1); return
        }
        tk_rt = TK_CONCAT; tk_rn = tk_byte_len(sql, ci, ci + 2); return
    }
    if (cls == CC_QUOTE) {
        int delim = c0
        int j = ci + 1
        bool closed = false
        while (j < n) {
            int c = tk_cp(sql, j)
            if (c == delim) {
                if (tk_cp(sql, j + 1) == delim) {
                    j = j + 2
                } else {
                    closed = true
                    break
                }
            } else {
                j = j + 1
            }
        }
        if (closed) {
            if (delim == CP_SQUOTE) {
                tk_rt = TK_STRING; tk_rn = tk_byte_len(sql, ci, j + 1); return
            }
            tk_rt = TK_ID; tk_rn = tk_byte_len(sql, ci, j + 1); return
        }
        tk_rt = TK_ILLEGAL; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_QUOTE2) {
        int j = ci + 1
        while (j < n && tk_cp(sql, j) != ']') {
            j = j + 1
        }
        if (j < n) {
            tk_rt = TK_ID; tk_rn = tk_byte_len(sql, ci, j + 1); return
        }
        tk_rt = TK_ILLEGAL; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_DOT) {
        if (!tk_is_digit(tk_cp(sql, ci + 1))) {
            tk_rt = TK_DOT; tk_rn = tk_byte_len(sql, ci, ci + 1); return
        }
        tk_number(sql, ci)
            return
    }
    if (cls == CC_DIGIT) {
        tk_number(sql, ci)
            return
    }
    if (cls == CC_VARNUM) {
        int j = ci + 1
        while (j < n && tk_is_digit(tk_cp(sql, j))) {
            j = j + 1
        }
        tk_rt = TK_VARIABLE; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_DOLLAR || cls == CC_VARALPHA) {
        tk_variable(sql, ci)
            return
    }
    if (cls == CC_KYWD0) {
        if (tk_class(tk_cp(sql, ci + 1)) > CC_KYWD) {
            // A lone keyword-start letter: an identifier, with its
            // IdChar tail (which the C code reaches via break).
            tk_id(sql, ci)
            return
        }
        int j = ci + 2
        while (j < n && tk_class(tk_cp(sql, j)) <= CC_KYWD) {
            j = j + 1
        }
        if (j < n && tk_is_idchar(tk_cp(sql, j))) {
            // Keyword-shaped, but continues with a digit, '$' or a
            // non-ASCII character: an identifier.
            tk_id(sql, ci)
            return
        }
        int code = keyword_code(sql.substr(ci, j))
        tk_rt = code; tk_rn = tk_byte_len(sql, ci, j); return
    }
    if (cls == CC_X) {
        if (tk_cp(sql, ci + 1) == CP_SQUOTE) {
            // BLOB literal: x'...', hex digits only, even in count.
            int j = ci + 2
            while (j < n && tk_is_xdigit(tk_cp(sql, j))) {
                j = j + 1
            }
            bool bad = false
            if (tk_cp(sql, j) != CP_SQUOTE || (j - ci) % 2 == 1) {
                bad = true
            }
            if (bad) {
                while (j < n && tk_cp(sql, j) != CP_SQUOTE) {
                    j = j + 1
                }
            }
            if (j < n) {
                j = j + 1
            }
            if (bad) {
                tk_rt = TK_ILLEGAL; tk_rn = tk_byte_len(sql, ci, j); return
            }
            tk_rt = TK_BLOB; tk_rn = tk_byte_len(sql, ci, j); return
        }
        tk_id(sql, ci)
            return
    }
    if (cls == CC_KYWD || cls == CC_ID || cls == CC_BOM) {
        tk_id(sql, ci)
            return
    }
    // CC_ILLEGAL and anything unhandled: one character, TK_ILLEGAL.
    tk_rt = TK_ILLEGAL; tk_rn = tk_byte_len(sql, ci, ci + 1); return
}


// Scan-result registers. The internal scanners report through
// these module variables instead of tuple returns, because a
// tuple-returning function cannot be used across a file or module
// boundary in current Come (docs/COME_GAPS.md #7) -- an importer
// would receive prototypes referencing undefined result types.
// This mirrors the C code's out-parameters in a form Come can
// express. tk_j/tk_t are the in/out pair of tk_scan_digits.
int tk_rt = 0
int tk_rn = 0
int tk_j = 0
int tk_t = 0

void tk_scan_digits(string sql) {
    int n = sql.length()
    while (tk_j < n) {
        int c = tk_cp(sql, tk_j)
        if (tk_is_digit(c)) {
            tk_j = tk_j + 1
        } else if (c == '_') {
            tk_t = TK_QNUMBER
            tk_j = tk_j + 1
        } else {
            break
        }
    }
    return
}


// ----------------------------------------------------------------
// Number scanning (CC_DIGIT, and CC_DOT when a digit follows), shared
// by get_token exactly as in the C code, where CC_DOT falls through
// into CC_DIGIT.

void tk_number(string sql, int ci) {
    int n = sql.length()
    int t = TK_INTEGER
    int j = ci
    if (tk_cp(sql, ci) == '0' && (tk_cp(sql, ci + 1) == 'x' || tk_cp(sql, ci + 1) == 'X') && tk_is_xdigit(tk_cp(sql, ci + 2))) {
        // Hexadecimal integer, 0x...
        j = ci + 3
        while (j < n) {
            int c = tk_cp(sql, j)
            if (tk_is_xdigit(c)) {
                j = j + 1
            } else if (c == '_') {
                t = TK_QNUMBER
                j = j + 1
            } else {
                break
            }
        }
    } else {
        tk_j = j; tk_t = t; tk_scan_digits(sql); j = tk_j; t = tk_t
        if (tk_cp(sql, j) == '.') {
            if (t == TK_INTEGER) { t = TK_FLOAT }
            j = j + 1
            tk_j = j; tk_t = t; tk_scan_digits(sql); j = tk_j; t = tk_t
        }
        int e = tk_cp(sql, j)
        if ((e == 'e' || e == 'E') && (tk_is_digit(tk_cp(sql, j + 1)) || ((tk_cp(sql, j + 1) == '+' || tk_cp(sql, j + 1) == '-') && tk_is_digit(tk_cp(sql, j + 2))))) {
            if (t == TK_INTEGER) { t = TK_FLOAT }
            j = j + 2
            tk_j = j; tk_t = t; tk_scan_digits(sql); j = tk_j; t = tk_t
        }
    }
    // A number directly followed by identifier characters is one
    // illegal token in SQLite ("1e", "0xG", "123abc").
    while (j < n && tk_is_idchar(tk_cp(sql, j))) {
        t = TK_ILLEGAL
        j = j + 1
    }
    tk_rt = t
    tk_rn = tk_byte_len(sql, ci, j)
    return
}

// Variable scanning (CC_DOLLAR and CC_VARALPHA): $, @, :, # names,
// including the Tcl-style $name(...) form (SQLITE_OMIT_TCL_VARIABLE
// is not defined in a default build).
void tk_variable(string sql, int ci) {
    int n = sql.length()
    int t = TK_VARIABLE
    int cnt = 0
    int j = ci + 1
    bool done = false
    while (j < n && !done) {
        int c = tk_cp(sql, j)
        if (tk_is_idchar(c)) {
            cnt = cnt + 1
            j = j + 1
        } else if (c == '(' && cnt > 0) {
            j = j + 1
            while (j < n && !tk_is_space(tk_cp(sql, j)) && tk_cp(sql, j) != ')') {
                j = j + 1
            }
            if (j < n && tk_cp(sql, j) == ')') {
                j = j + 1
            } else {
                t = TK_ILLEGAL
            }
            done = true
        } else if (c == ':' && tk_cp(sql, j + 1) == ':') {
            j = j + 2
        } else {
            done = true
        }
    }
    if (cnt == 0) { t = TK_ILLEGAL }
    tk_rt = t
    tk_rn = tk_byte_len(sql, ci, j)
    return
}

// Identifier tail shared by the CC_KYWD / CC_ID / CC_X cases: the
// first character is already known to start an identifier; consume
// the IdChar run.
void tk_id(string sql, int ci) {
    int n = sql.length()
    int j = ci + 1
    while (j < n && tk_is_idchar(tk_cp(sql, j))) {
        j = j + 1
    }
    tk_rt = TK_ID
    tk_rn = tk_byte_len(sql, ci, j)
    return
}



// ----------------------------------------------------------------
// Public API
//
// tk_get_token above is the faithful sqlite3GetToken port, but its
// (type, len) tuple cannot be destructured by code in another
// module in current Come (docs/COME_GAPS.md #7), and a struct
// return does not survive the module boundary either (#9). The
// public surface is therefore scalar functions plus a cursor.

// token_type_at: the type of the token starting at byte_pos.
int token_type_at(string sql, int byte_pos) {
    tk_get_token(sql, byte_pos)
    return tk_rt
}

// token_len_at: the byte length of the token starting at byte_pos.
int token_len_at(string sql, int byte_pos) {
    tk_get_token(sql, byte_pos)
    return tk_rn
}

// The text of the token at (byte_start, byte_len) in sql.
string token_text(string sql, int byte_start, int byte_len) {
    int ci = 0
    int b = 0
    while (b < byte_start) {
        b = b + tk_utf8_len(tk_cp(sql, ci))
        ci = ci + 1
    }
    int cj = ci
    int e = byte_start
    while (e < byte_start + byte_len) {
        e = e + tk_utf8_len(tk_cp(sql, cj))
        cj = cj + 1
    }
    return sql.substr(ci, cj)
}

// Cursor API (stateful: use through an instance).
//
//   var tz = tokenizer.create()
//   tz.open(sql)
//   while (tz.next()) {
//       ... tz.typ(), tz.start(), tz.len(), tz.text() ...
//   }
//
// next() returns false at end of input, with typ() == TK_ILLEGAL
// and len() == 0 -- the same signal sqlite3GetToken gives on the
// terminating NUL.

string tz_sql = ""
int tz_pos = 0
int tz_start = 0
int tz_typ = 0
int tz_len = 0

void open(string sql) {
    tz_sql = sql
    tz_pos = 0
    tz_start = 0
    tz_typ = 0
    tz_len = 0
}

bool next() {
    if (tz_pos >= tz_sql.bytesize()) {
        tz_start = tz_pos
        tz_typ = TK_ILLEGAL
        tz_len = 0
        return false
    }
    tk_get_token(tz_sql, tz_pos)
    tz_start = tz_pos
    tz_typ = tk_rt
    tz_len = tk_rn
    if (tk_rn == 0) {
        return false
    }
    tz_pos = tz_pos + tk_rn
    return true
}

int typ() {
    return tz_typ
}

int start() {
    return tz_start
}

int len() {
    return tz_len
}

string text() {
    return token_text(tz_sql, tz_start, tz_len)
}
