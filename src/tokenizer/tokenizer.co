module tokenizer

import string

// tokenizer.co -- SQLite's SQL tokenizer, ported to Come.
//
// A faithful port of sqlite3GetToken() from SQLite's src/tokenize.c
// (trunk f879fb1). Token codes live below (generated from parse.h),
// keyword lookup in keywords.co, character classes in chars.co,
// token names in names.co -- all one module: tokenizer. SQLite is
// public domain; see docs/PROVENANCE.md.
//
// The scanner works on the input's BYTES, exactly like the C
// code: sql.byte_array() hands over the UTF-8 bytes (that call
// reaches its runtime since COIL-141), and every offset/length
// in the API is a byte offset, as in C. The only inputs that
// cannot be scanned are ones a Come string cannot hold at all
// (embedded NUL, invalid UTF-8) -- see docs/BEHAVIOR.md.
//
// Public API:
//   (type, byte_len) = get_token(sql, byte_pos)  -- sqlite3GetToken
//   code = keyword_code(word)                    -- TK_* or TK_ID
//   name = token_name(type)                      -- "TK_SELECT" or ""
//   cursor: var tz = tokenizer.create(); tz.open/next/typ/...
//
// Token constants (TK_*) are shared by every file of this
// module (spec 3.4, COIL-148), but they are not exported:
// a module's export surface caps at 64 symbols and silently
// drops the rest (docs/COME_GAPS.md #16), and 186 constants
// do not fit. Callers compare token_name() or the raw values
// in docs/TOKEN_MAP.md.

export (
    (int, int) get_token(string sql, int byte_pos),
    void open(string sql),
    bool next(),
    int typ(),
    int start(),
    int len(),
    string text(),
    int token_type_at(string sql, int byte_pos),
    int token_len_at(string sql, int byte_pos),
    string token_text(string sql, int byte_start, int byte_len),
    int keyword_code(string word),
    string token_name(int t),
)

// Token codes: SQLite parse.h values, generated. Do not edit the
