module tokenizer

import string

// Only the public API is exported; the tk_* internals stay
// module-private (their tuple returns do not survive an importer
// boundary in current Come -- docs/COME_GAPS.md #7).
export (
    void open(string sql),
    bool next(),
    int typ(),
    int start(),
    int len(),
    string text(),
    int token_type_at(string sql, int byte_pos),
    int token_len_at(string sql, int byte_pos),
    string token_text(string sql, int byte_start, int byte_len),
    int keyword_code(string word),
    string token_name(int t),
)

// tokenizer.co -- SQLite's SQL tokenizer, ported to Come.
//
// A faithful port of sqlite3GetToken() from SQLite's src/tokenize.c
// (trunk f879fb1). Token codes live in tokens.co, keyword lookup in
// keywords.co, token names in names.co (all one module: tokenizer).
// SQLite is public domain; see docs/PROVENANCE.md.
//
// The one structural adaptation: C scans a NUL-terminated byte
// string, Come strings are immutable UTF-8 and character-first
// (s[i] is a codepoint, .length() counts characters). This port
// scans by codepoint and converts token extents back to BYTE
// offsets/lengths with tk_utf8_len(), so the public API is
// byte-exact like the C one for every valid-UTF-8 input. Inputs a
// Come string cannot hold at all (embedded NUL, invalid UTF-8)
// are documented in docs/BEHAVIOR.md.
//
// Public API:
//   (type, byte_len) = get_token(sql, byte_pos)  -- sqlite3GetToken
//   code = keyword_code(word)                    -- TK_* or TK_ID
//   name = token_name(type)                      -- "TK_SELECT" or ""
//
// Token constants (TK_*) are defined in tokens.co with SQLite's
// values (below). Come cannot yet read another module's
// constants (spec 3.4 gap, docs/COME_GAPS.md #1), so callers
// compare against token_name() or docs/TOKEN_MAP.md.

// Token codes: SQLite parse.h values, generated. Do not edit the
// marked block by hand; regenerate with tools/gen_token_data.py.
const (
// BEGIN GENERATED: token-consts
    TK_SEMI = 1,
    TK_EXPLAIN = 2,
    TK_QUERY = 3,
    TK_PLAN = 4,
    TK_BEGIN = 5,
    TK_TRANSACTION = 6,
    TK_DEFERRED = 7,
    TK_IMMEDIATE = 8,
    TK_EXCLUSIVE = 9,
    TK_COMMIT = 10,
    TK_END = 11,
    TK_ROLLBACK = 12,
    TK_SAVEPOINT = 13,
    TK_RELEASE = 14,
    TK_TO = 15,
    TK_TABLE = 16,
    TK_CREATE = 17,
    TK_IF = 18,
    TK_NOT = 19,
    TK_EXISTS = 20,
    TK_TEMP = 21,
    TK_LP = 22,
    TK_RP = 23,
    TK_AS = 24,
    TK_COMMA = 25,
    TK_WITHOUT = 26,
    TK_ABORT = 27,
    TK_ACTION = 28,
    TK_AFTER = 29,
    TK_ANALYZE = 30,
    TK_ASC = 31,
    TK_ATTACH = 32,
