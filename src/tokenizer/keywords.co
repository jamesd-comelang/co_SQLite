    m["key"] = 68
    m["last"] = 85
    m["left"] = 119
    m["like"] = 48
    m["limit"] = 149
    m["match"] = 47
    m["materialized"] = 98
    m["natural"] = 119
    m["no"] = 67
    m["not"] = 19
    m["nothing"] = 153
    m["notnull"] = 52
    m["null"] = 122
    m["nulls"] = 83
    m["of"] = 69
    m["offset"] = 70
    m["on"] = 116
    m["or"] = 43
    m["order"] = 146
    m["others"] = 94
    m["outer"] = 119
    m["over"] = 166
    m["partition"] = 88
    m["plan"] = 4
    m["pragma"] = 71
    m["preceding"] = 89
    m["primary"] = 123
    m["query"] = 3
    m["raise"] = 72
    m["range"] = 90
