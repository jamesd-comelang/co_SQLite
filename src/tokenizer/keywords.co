    m["detach"] = 40
    m["distinct"] = 141
    m["do"] = 62
    m["drop"] = 134
    m["each"] = 41
    m["else"] = 161
    m["end"] = 11
    m["escape"] = 59
    m["except"] = 137
    m["exclude"] = 92
    m["exclusive"] = 9
    m["exists"] = 20
    m["explain"] = 2
    m["fail"] = 42
    m["filter"] = 167
    m["first"] = 84
    m["following"] = 87
    m["for"] = 63
    m["foreign"] = 133
    m["from"] = 143
    m["full"] = 119
    m["generated"] = 96
    m["glob"] = 48
    m["group"] = 147
    m["groups"] = 93
    m["having"] = 148
    m["if"] = 18
    m["ignore"] = 64
    m["immediate"] = 8
    m["in"] = 50
    m["index"] = 162
    m["indexed"] = 117
    m["initially"] = 65
    m["inner"] = 119
    m["insert"] = 128
    m["instead"] = 66
    m["intersect"] = 138
    m["into"] = 152
    m["is"] = 45
    m["isnull"] = 51
