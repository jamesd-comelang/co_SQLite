module tokenizer

import string

// keywords.co -- sqlite3KeywordCode() for module tokenizer.

// ----------------------------------------------------------------
// keyword_code -- sqlite3KeywordCode(): the TK_* code for a word,
// case-insensitively, or TK_ID when the word is not a keyword.
// SQLite uses a generated perfect hash (keywordhash.h); Come has no
// const tables, so this builds a map{string,int} per call -- correct,
// not fast. See docs/COME_GAPS.md #4.


// TK_ID is declared in tokens.co, but Come codegen resolves
// constants per-file, so this file carries its own copy of the one
// constant it uses (same SQLite value; see docs/COME_GAPS.md #6).
const KW_FALLBACK_ID = 60

int keyword_code(string word) {
    map{string, int} m
// BEGIN GENERATED: keyword-map
    m["abort"] = 27
    m["action"] = 28
    m["add"] = 164
    m["after"] = 29
    m["all"] = 136
    m["alter"] = 163
    m["always"] = 97
    m["analyze"] = 30
    m["and"] = 44
    m["as"] = 24
    m["asc"] = 31
    m["attach"] = 32
    m["autoincrement"] = 127
    m["before"] = 33
    m["begin"] = 5
    m["between"] = 49
    m["by"] = 34
    m["cascade"] = 35
    m["case"] = 158
    m["cast"] = 36
    m["check"] = 125
